# Copy to .env for local testing. On GitHub these go in
# Settings → Secrets and variables → Actions → New repository secret.

# AI writer — set at least ONE. With provider "auto" the first one set wins:
# Claude → Gemini → OpenRouter. Free: Gemini, OpenRouter.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LinkedIn (from tools/linkedin_auth.py)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_TOKEN_EXPIRES=          # YYYY-MM-DD, used for renewal reminders

# Meta (from tools/meta_tokens.py) — one Page token covers Facebook + Instagram
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
IG_USER_ID=

# Threads (from tools/threads_auth.py)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_TOKEN_EXPIRES=           # YYYY-MM-DD

# Instant mode (Cloudflare worker, SETUP.md step 9) — optional
WORKER_URL=                      # https://posting-agent.<you>.workers.dev
WORKER_SECRET=                   # from: python tools/telegram_webhook.py secret
